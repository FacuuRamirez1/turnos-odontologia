# backend/.env.example — ver /.env.example (contrato canonico). Mismas vars, scope api/worker.
# P5: secretos SOLO por env vars. P11: valores MP ficticios. P15: simulado prohibido en produccion.

# --- Entorno ---
# dev | test | production. `production` activa los guards de arranque P5/P15.
ENVIRONMENT=dev

# --- Base de datos (hostnames del compose) ---
DATABASE_URL=postgresql+psycopg://turnos:turnos@db:5432/turnos

# --- Colas ---
REDIS_URL=redis://redis:6379/0

# --- Auth JWT (cambiar en produccion!) ---
JWT_SECRET=cambiar-en-produccion
JWT_ACCESS_MIN=15
JWT_REFRESH_DIAS=7
JWT_ACTION_MIN=15

# --- Cifrado de sensibles en reposo (C-13, pgcrypto) ---
ENC_KEY=cambiar-en-dev

# --- MercadoPago (opcionales: solo con PAGO_MODO=mercadopago) ---
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Se usa tambien en modo simulado (firma del evento).
MP_WEBHOOK_SECRET=cambiar-en-dev

# --- Mail (MailHog en el compose) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=turnos@clinica-ficticia.example.ar

# --- Parametros resueltos ---
RECORDATORIO_VENTANA_HS=24
RESERVA_TTL_MIN=15
RESERVA_RATE_LIMIT=10
ANTICIPACION_MIN_HS=24
TIMEZONE=America/Argentina/Cordoba
MAIL_ACTION_TTL_MIN=2880
MAIL_RATE_LIMIT=30
API_PUBLIC_URL=http://localhost:8000
WORKER_SCHEDULER_TICK_S=60

# --- Worker de mails: opcionales (defaults mostrados) ---
# WORKER_QUEUE=mail:pendientes
# WORKER_HEARTBEAT_FILE=/tmp/worker.heartbeat

FRONTEND_URL=http://localhost:5173

# --- Flags v2 APAGADOS en v1 (P13) ---
WHATSAPP_ENABLED=false
ARCA_ENABLED=false

# --- Pagos simulados (D14/P15) ---
PAGO_MODO=simulado
