# .env.example — contrato de entorno v1 (08 §4). Copiar a .env y completar.
# P5: secretos SOLO por env vars. P11: valores MP ficticios de prueba, nada real.
# P13: WHATSAPP_ENABLED y ARCA_ENABLED siempre false en v1.
# P15: PAGO_MODO=simulado prohibido con ENVIRONMENT=production.

# --- Entorno ---
# dev | test | production. `production` activa los guards de arranque P5/P15.
ENVIRONMENT=dev

# --- Base de datos ---
DATABASE_URL=postgresql+psycopg://turnos:turnos@localhost:5432/turnos

# --- Colas ---
REDIS_URL=redis://localhost:6379/0

# --- Auth JWT (cambiar en produccion!) ---
JWT_SECRET=cambiar-en-produccion
# TTLs JWT C-03 (minutos access/accion, dias refresh; env-overridables).
JWT_ACCESS_MIN=15
JWT_REFRESH_DIAS=7
JWT_ACTION_MIN=15

# --- Cifrado de sensibles en reposo (C-13, pgcrypto) ---
# Clave simetrica de pgp_sym_encrypt/pgp_sym_decrypt. Nunca commitear un valor real.
ENC_KEY=cambiar-en-dev

# --- MercadoPago (PAGO_MODO=mercadopago es v2, no construido en el MVP) ---
# Titular ficticio: Clinica Odontologica Ficticia S.R.L. Jamas datos reales (P11).
# MP_ACCESS_TOKEN y MP_PUBLIC_KEY son opcionales: se exigen solo con PAGO_MODO=mercadopago.
# Con PAGO_MODO=simulado (default v1, D14) no se consumen.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Firma HMAC del webhook server-to-server; se usa tambien en modo simulado.
MP_WEBHOOK_SECRET=cambiar-en-dev

# --- Mail local (MailHog en dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# P14: la app envia SOLO desde MAIL_FROM alineado, via workers Redis (C-09).
MAIL_FROM=turnos@clinica-ficticia.example.ar

# --- Parametros resueltos (no cambiar sin decision registrada) ---
# Anticipacion minima default 24 h (consumida en C-04/C-05).
RECORDATORIO_VENTANA_HS=24
RESERVA_TTL_MIN=15
# C-05: rate-limit POST /reservas por IP (10/min, tunable).
RESERVA_RATE_LIMIT=10
# C-04: anticipacion minima de slots + zona del consultorio (D-ANT/D-TZ).
ANTICIPACION_MIN_HS=24
TIMEZONE=America/Argentina/Cordoba
# Reintentos de mail: 3 con backoff via workers Redis (consumidos en C-09).
MAIL_ACTION_TTL_MIN=2880
MAIL_RATE_LIMIT=30
API_PUBLIC_URL=http://localhost:8000
WORKER_SCHEDULER_TICK_S=60

# --- Worker de mails: opcionales (defaults mostrados) ---
# WORKER_QUEUE=mail:pendientes
# WORKER_HEARTBEAT_FILE=/tmp/worker.heartbeat

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Flags v2 APAGADOS en v1 (P13) ---
WHATSAPP_ENABLED=false
ARCA_ENABLED=false

# --- Pagos simulados (D14/P15) ---
# simulado (default MVP/dev) | mercadopago (v2). Nunca simulado en produccion.
PAGO_MODO=simulado

# --- Overrides de puertos de docker-compose (opcionales; defaults mostrados) ---
# API_PORT=8000
# WEB_PORT=5173
# PG_PORT=5432
# REDIS_PORT=6379
# MAILHOG_SMTP_PORT=1025
# MAILHOG_HTTP_PORT=8025
