# .env.example — contrato de entorno v1 (08 §4). Copiar a .env y completar.
# P5: secretos SOLO por env vars. P11: valores MP ficticios de prueba, nada real.
# P13: WHATSAPP_ENABLED y ARCA_ENABLED siempre false en v1.

# --- Base de datos ---
DATABASE_URL=postgresql+psycopg://turnos:turnos@localhost:5432/turnos

# --- Colas ---
REDIS_URL=redis://localhost:6379/0

# --- Auth JWT (cambiar en produccion!) ---
JWT_SECRET=cambiar-en-produccion
# TTLs JWT C-03 (minutos access/acción, días refresh; env-overridables).
JWT_ACCESS_MIN=15
JWT_REFRESH_DIAS=7
JWT_ACTION_MIN=15

# --- MercadoPago PRUEBA (titular ficticio: Clinica Odontologica Ficticia S.R.L.) ---
# Solo vars: no se consumen hasta C-07. Jamas datos reales en el repo (P11).
MP_ACCESS_TOKEN=TEST-ficticio-cambiar-en-produccion
MP_WEBHOOK_SECRET=cambiar-en-produccion

# --- Mail local (MailHog en dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# P14: la app envia SOLO desde MAIL_FROM alineado, via workers Redis (C-09).
MAIL_FROM=turnos@clinica-ficticia.example.ar

# --- Parametros resueltos (no cambiar sin decision registrada) ---
# Anticipacion minima default 24 h (consumida en C-04/C-05).
RECORDATORIO_VENTANA_HS=24
RESERVA_TTL_MIN=15
# C-05: rate-limit POST /reservas por IP (10/min, tunable).
RESERVA_RATE_LIMIT=10
# C-04: anticipación mínima de slots + zona del consultorio (D-ANT/D-TZ).
ANTICIPACION_MIN_HS=24
TIMEZONE=America/Argentina/Cordoba
# Reintentos de mail: 3 con backoff via workers Redis (consumidos en C-09).

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Flags v2 APAGADOS en v1 (P13) ---
WHATSAPP_ENABLED=false
ARCA_ENABLED=false
